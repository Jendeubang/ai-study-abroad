# SQLite development database. Use an absolute path or a path relative to project root.
DATABASE_URL=sqlite:///./study_abroad.db
# Comma-separated exact origins. Empty means browser cross-origin requests are denied.
ALLOWED_ORIGINS=
# Per-request response timeout in seconds.
REQUEST_TIMEOUT_SECONDS=20
# AI configuration stays on the server; never put these values in frontend code.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_TIMEOUT_SECONDS=6
