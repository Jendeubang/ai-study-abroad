# SQLite development database. Use an absolute path or a path relative to project root.
DATABASE_URL=sqlite:///./study_abroad.db
# Comma-separated exact origins. Empty means browser cross-origin requests are denied.
ALLOWED_ORIGINS=
# Per-request response timeout in seconds.
REQUEST_TIMEOUT_SECONDS=60
# AI configuration stays on the server; never put these values in frontend code.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_TIMEOUT_SECONDS=25
ADMIN_TOKEN=
# Hash vectors work without extra dependencies. For semantic vectors install requirements-vector.txt.
VECTOR_BACKEND=hash
VECTOR_MODEL_ID=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
VECTOR_MODEL_PATH=.models/multilingual-minilm
